<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PasswordValidator</RootNamespace>
    <AssemblyName>PasswordValidator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      External dependency: Zxcvbn (Dropbox's password strength estimator, .NET port).
      Replaces the hand-rolled scoring with a battle-tested entropy-based model.
    -->
    <PackageReference Include="Zxcvbn" Version="1.0.2" />
  </ItemGroup>

</Project>
